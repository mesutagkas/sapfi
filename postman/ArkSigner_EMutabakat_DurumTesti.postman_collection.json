      "item": [
        {
          "name": "CreateWorkflow A (bekleyen)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Success = true', () => pm.expect(r.Success).to.eql(true));",
                  "const key = r.Data && (r.Data.workflowKey || r.Data.WorkflowKey);",
                  "if (key) { pm.collectionVariables.set('wfKeyA', key); console.log('wfKeyA = ' + key); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Config\": {\n    \"AppId\": \"{{appId}}\",\n    \"Pass\": \"{{pass}}\"\n  },\n  \"Workflow\": {\n    \"WorkflowStartedBy\": \"{{startedBy}}\",\n    \"SendNotificationMailToFirstSigner\": false,\n    \"AddQR\": true,\n    \"DocumentWorkflow\": {\n      \"Name\": \"SAP entegrasyon testi A\",\n      \"Description\": \"E-Mutabakat ArkSigner durum sorgu testi\",\n      \"SignType\": \"PAdES\",\n      \"SignValidationTime\": \"EST\"\n    },\n    \"PostOperation\": {\n      \"IsDocumentToBeArchived\": false,\n      \"SendFtp\": false,\n      \"SendMail\": false,\n      \"MailAddresses\": \"\",\n      \"SaveToFolder\": false,\n      \"IsSendToAllUsersInWorkflow\": false,\n      \"SendToWebService\": false\n    },\n    \"WorkflowStepList\": [\n      {\n        \"Username\": \"\",\n        \"Name\": \"{{signerName}}\",\n        \"Surname\": \"{{signerSurname}}\",\n        \"IDNumber\": \"{{signerIdNumber}}\",\n        \"EmailAddress\": \"{{signerEmail}}\",\n        \"OrderNo\": 1,\n        \"TaskType\": {{taskType}},\n        \"CompletionRule\": 0,\n        \"WorkflowStepNotificationList\": [\n          {\n            \"WorkflowStepNotificationType\": 1\n          },\n          {\n            \"WorkflowStepNotificationType\": 2\n          }\n        ],\n        \"WorflowStepPrivilegeModelList\": [\n          {\n            \"WorkflowPrivilegeType\": 1\n          },\n          {\n            \"WorkflowPrivilegeType\": 2\n          }\n        ]\n      }\n    ],\n    \"FileList\": [\n      {\n        \"FileName\": \"mutabakat_test_A.pdf\",\n        \"FileType\": 0,\n        \"Data\": \"{{testPdf}}\"\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/services/WorkflowIntegrationV2/CreateWorkflow",
            "description": "Dokunulmayacak; bekleyen durum örneği."
          }
        },
