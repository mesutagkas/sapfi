// Depar — Prisma şeması
// Kaynak: docs/schema.sql  ·  Değişiklik yaparken iki dosyayı birlikte güncelle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUM'lar
// ============================================================

enum UserRole {
  seller
  supplier
  admin
  support
}

enum AccountStatus {
  pending
  active
  suspended
  closed
}

enum Marketplace {
  trendyol
  hepsiburada
  n11
  ciceksepeti
  pttavm
  amazon_tr
}

enum ListingStatus {
  draft
  pushing
  active
  passive
  rejected
  error
}

enum OrderStatus {
  new
  sent_to_supplier
  preparing
  shipped
  delivered
  cancelled
  returned
}

enum SubStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

enum LedgerType {
  debit
  credit
}

enum SourceType {
  manual
  excel
  xml
  api
  ecommerce_plugin
}

enum BillingPeriod {
  monthly
  yearly
}

// ============================================================
// 1. HESAPLAR
// ============================================================

/// Satıcı VEYA tedarikçi firması. Tüm veriler tenantId ile izole edilir.
model Tenant {
  id            String        @id @default(uuid()) @db.Uuid
  kind          UserRole
  status        AccountStatus @default(pending)
  companyName   String        @map("company_name")
  taxOffice     String?       @map("tax_office")
  taxNumber     String?       @map("tax_number")
  mersisNo      String?       @map("mersis_no")
  iban          String?
  address       Json          @default("{}")
  phone         String?
  email         String?
  slug          String?       @unique

  // tedarikçi performans alanları
  avgShipDays   Decimal?      @map("avg_ship_days") @db.Decimal(4, 2)
  cancelRate    Decimal?      @map("cancel_rate") @db.Decimal(5, 2)
  stockAccuracy Decimal?      @map("stock_accuracy") @db.Decimal(5, 2)

  approvedAt    DateTime?     @map("approved_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  users            User[]
  documents        TenantDocument[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  usageCounters    UsageCounter[]
  products         Product[]
  feeds            SupplierFeed[]
  channelAccounts  ChannelAccount[]
  listings         Listing[]
  orders           Order[]
  orderItems       OrderItem[]
  shipments        Shipment[]
  returns          Return[]
  notifications    Notification[]
  syncLogs         SyncLog[]
  ledgerAsSeller   LedgerEntry[]  @relation("ledgerSeller")
  ledgerAsSupplier LedgerEntry[]  @relation("ledgerSupplier")
  limitsAsSeller   CreditLimit[]  @relation("limitSeller")
  limitsAsSupplier CreditLimit[]  @relation("limitSupplier")

  @@index([kind, status])
  @@map("tenants")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  role         UserRole
  isOwner      Boolean   @default(false) @map("is_owner")
  twoFaSecret  String?   @map("two_fa_secret")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  notifications Notification[]

  @@index([tenantId])
  @@map("users")
}

/// Refresh token'lar hash'lenerek saklanır; rotasyon ve iptal için gerekli.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model TenantDocument {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  docType   String   @map("doc_type")
  fileUrl   String   @map("file_url")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_documents")
}

// ============================================================
// 2. ABONELİK
// ============================================================

model Plan {
  code            String  @id
  name            String
  monthlyPrice    Decimal @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice     Decimal @map("yearly_price") @db.Decimal(10, 2)
  maxProducts     Int?    @map("max_products")
  maxChannels     Int?    @map("max_channels")
  maxOrdersMonth  Int?    @map("max_orders_month")
  maxUsers        Int?    @map("max_users")
  syncIntervalMin Int     @map("sync_interval_min")
  hasPriceRules   Boolean @default(false) @map("has_price_rules")
  hasApi          Boolean @default(false) @map("has_api")
  isActive        Boolean @default(true) @map("is_active")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  planCode          String        @map("plan_code")
  status            SubStatus     @default(trialing)
  billingPeriod     BillingPeriod @default(monthly) @map("billing_period")
  trialEndsAt       DateTime?     @map("trial_ends_at") @db.Timestamptz(6)
  currentStart      DateTime      @default(now()) @map("current_start") @db.Timestamptz(6)
  currentEnd        DateTime      @map("current_end") @db.Timestamptz(6)
  cancelAtPeriodEnd Boolean       @default(false) @map("cancel_at_period_end")
  provider          String?
  providerRef       String?       @map("provider_ref")
  cardToken         String?       @map("card_token")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planCode], references: [code])
  invoices Invoice[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

model Invoice {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  subscriptionId String?   @map("subscription_id") @db.Uuid
  amount         Decimal   @db.Decimal(12, 2)
  vatAmount      Decimal   @default(0) @map("vat_amount") @db.Decimal(12, 2)
  currency       String    @default("TRY")
  status         String    @default("pending")
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  providerRef    String?   @map("provider_ref")
  einvoiceUuid   String?   @map("einvoice_uuid")
  pdfUrl         String?   @map("pdf_url")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("invoices")
}

model UsageCounter {
  tenantId String   @map("tenant_id") @db.Uuid
  period   DateTime @db.Date
  orders   Int      @default(0)
  apiCalls Int      @default(0) @map("api_calls")
  pushes   Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, period])
  @@map("usage_counters")
}

// ============================================================
// 3. KATALOG
// ============================================================

model Category {
  id       BigInt  @id @default(autoincrement())
  parentId BigInt? @map("parent_id")
  name     String
  path     String
  vatRate  Decimal @default(20) @map("vat_rate") @db.Decimal(4, 2)

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryTree")
  products Product[]
  mappings CategoryMapping[]

  @@map("categories")
}

model CategoryMapping {
  id            BigInt      @id @default(autoincrement())
  categoryId    BigInt      @map("category_id")
  channel       Marketplace
  remoteId      String      @map("remote_id")
  remotePath    String?     @map("remote_path")
  requiredAttrs Json        @default("[]") @map("required_attrs")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, channel])
  @@map("category_mappings")
}

model Product {
  id          String     @id @default(uuid()) @db.Uuid
  supplierId  String     @map("supplier_id") @db.Uuid
  categoryId  BigInt?    @map("category_id")
  sku         String
  title       String
  description String?
  brand       String?
  source      SourceType @default(manual)
  isActive    Boolean    @default(true) @map("is_active")
  attributes  Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier Tenant           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  @@unique([supplierId, sku])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantSku   String   @map("variant_sku")
  barcode      String?
  options      Json     @default("{}")
  supplyPrice  Decimal  @map("supply_price") @db.Decimal(12, 2)
  vatRate      Decimal  @default(20) @map("vat_rate") @db.Decimal(4, 2)
  msrp         Decimal? @db.Decimal(12, 2)
  stock        Int      @default(0)
  desi         Decimal? @db.Decimal(6, 2)
  shipDays     Int      @default(1) @map("ship_days")
  isActive     Boolean  @default(true) @map("is_active")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  listings   Listing[]
  orderItems OrderItem[]

  @@unique([productId, variantSku])
  @@index([barcode])
  @@map("product_variants")
}

model ProductImage {
  id        BigInt @id @default(autoincrement())
  productId String @map("product_id") @db.Uuid
  url       String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model SupplierFeed {
  id          String     @id @default(uuid()) @db.Uuid
  supplierId  String     @map("supplier_id") @db.Uuid
  kind        SourceType
  url         String?
  auth        Json?
  fieldMap    Json       @default("{}") @map("field_map")
  intervalMin Int        @default(60) @map("interval_min")
  lastRunAt   DateTime?  @map("last_run_at") @db.Timestamptz(6)
  lastStatus  String?    @map("last_status")
  lastError   String?    @map("last_error")

  supplier Tenant @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_feeds")
}

// ============================================================
// 4. PAZARYERİ BAĞLANTILARI VE İLANLAR
// ============================================================

model ChannelAccount {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  channel             Marketplace
  storeName           String?       @map("store_name")
  merchantId          String?       @map("merchant_id")
  /// AES-256-GCM ile şifreli JSON — ham anahtar asla saklanmaz (docs/05).
  credentials         Bytes
  status              AccountStatus @default(pending)
  lastCheckAt         DateTime?     @map("last_check_at") @db.Timestamptz(6)
  lastError           String?       @map("last_error")
  commissionOverrides Json          @default("{}") @map("commission_overrides")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listings Listing[]
  batches  ChannelBatch[]
  orders   Order[]

  @@unique([tenantId, channel, merchantId])
  @@map("channel_accounts")
}

model Listing {
  id               String        @id @default(uuid()) @db.Uuid
  sellerId         String        @map("seller_id") @db.Uuid
  channelAccountId String        @map("channel_account_id") @db.Uuid
  variantId        String        @map("variant_id") @db.Uuid
  remoteId         String?       @map("remote_id")
  remoteSku        String?       @map("remote_sku")
  salePrice        Decimal       @map("sale_price") @db.Decimal(12, 2)
  priceRule        Json?         @map("price_rule")
  status           ListingStatus @default(draft)
  lastSyncedAt     DateTime?     @map("last_synced_at") @db.Timestamptz(6)
  lastError        String?       @map("last_error")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  seller         Tenant         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]

  @@unique([channelAccountId, variantId])
  @@index([sellerId, status])
  @@index([variantId])
  @@map("listings")
}

model ChannelBatch {
  id               String   @id @default(uuid()) @db.Uuid
  channelAccountId String   @map("channel_account_id") @db.Uuid
  batchRef         String   @map("batch_ref")
  kind             String
  itemCount        Int      @default(0) @map("item_count")
  status           String   @default("pending")
  result           Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("channel_batches")
}

// ============================================================
// 5. SİPARİŞLER
// ============================================================

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  sellerId         String      @map("seller_id") @db.Uuid
  channelAccountId String      @map("channel_account_id") @db.Uuid
  channel          Marketplace
  remoteOrderId    String      @map("remote_order_id")
  orderNumber      String?     @map("order_number")
  status           OrderStatus @default(new)
  customerName     String?     @map("customer_name")
  customerPhone    String?     @map("customer_phone")
  shippingAddress  Json        @map("shipping_address")
  totalAmount      Decimal     @map("total_amount") @db.Decimal(12, 2)
  commissionAmount Decimal     @default(0) @map("commission_amount") @db.Decimal(12, 2)
  shippingCost     Decimal     @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  supplyTotal      Decimal     @default(0) @map("supply_total") @db.Decimal(12, 2)
  netProfit        Decimal     @default(0) @map("net_profit") @db.Decimal(12, 2)
  orderedAt        DateTime    @map("ordered_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  seller         Tenant         @relation(fields: [sellerId], references: [id])
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id])
  items          OrderItem[]
  shipments      Shipment[]
  returns        Return[]
  ledgerEntries  LedgerEntry[]

  @@unique([channelAccountId, remoteOrderId])
  @@index([sellerId, orderedAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String      @id @default(uuid()) @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  listingId    String?     @map("listing_id") @db.Uuid
  variantId    String?     @map("variant_id") @db.Uuid
  supplierId   String      @map("supplier_id") @db.Uuid
  title        String
  quantity     Int
  unitPrice    Decimal     @map("unit_price") @db.Decimal(12, 2)
  supplyPrice  Decimal     @map("supply_price") @db.Decimal(12, 2)
  status       OrderStatus @default(new)
  supplierNote String?     @map("supplier_note")

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing  Listing?        @relation(fields: [listingId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])
  supplier Tenant          @relation(fields: [supplierId], references: [id])
  returns  Return[]

  @@index([supplierId, status])
  @@index([orderId])
  @@map("order_items")
}

model Shipment {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  carrier         String?
  trackingNo      String?   @map("tracking_no")
  labelUrl        String?   @map("label_url")
  shippedAt       DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz(6)
  pushedToChannel Boolean   @default(false) @map("pushed_to_channel")

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier Tenant @relation(fields: [supplierId], references: [id])

  @@index([orderId])
  @@map("shipments")
}

model Return {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  orderItemId  String?  @map("order_item_id") @db.Uuid
  supplierId   String   @map("supplier_id") @db.Uuid
  reason       String?
  status       String   @default("requested")
  refundAmount Decimal? @map("refund_amount") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order     Order      @relation(fields: [orderId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  supplier  Tenant     @relation(fields: [supplierId], references: [id])

  @@map("returns")
}

// ============================================================
// 6. CARİ HESAP
// ============================================================

model LedgerEntry {
  id          BigInt     @id @default(autoincrement())
  sellerId    String     @map("seller_id") @db.Uuid
  supplierId  String     @map("supplier_id") @db.Uuid
  orderId     String?    @map("order_id") @db.Uuid
  type        LedgerType
  amount      Decimal    @db.Decimal(12, 2)
  description String?
  documentNo  String?    @map("document_no")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  seller   Tenant @relation("ledgerSeller", fields: [sellerId], references: [id])
  supplier Tenant @relation("ledgerSupplier", fields: [supplierId], references: [id])
  order    Order? @relation(fields: [orderId], references: [id])

  @@index([sellerId, supplierId, createdAt(sort: Desc)])
  @@map("ledger_entries")
}

model CreditLimit {
  sellerId    String  @map("seller_id") @db.Uuid
  supplierId  String  @map("supplier_id") @db.Uuid
  limitAmount Decimal @default(0) @map("limit_amount") @db.Decimal(12, 2)

  seller   Tenant @relation("limitSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  supplier Tenant @relation("limitSupplier", fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([sellerId, supplierId])
  @@map("credit_limits")
}

// ============================================================
// 7. BİLDİRİM, KAYIT, DENETİM
// ============================================================

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String?
  link      String?
  channels  String[]  @default(["inapp"])
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("notifications")
}

model SyncLog {
  id          BigInt       @id @default(autoincrement())
  tenantId    String?      @map("tenant_id") @db.Uuid
  channel     Marketplace?
  job         String
  status      String
  itemsOk     Int          @default(0) @map("items_ok")
  itemsFailed Int          @default(0) @map("items_failed")
  durationMs  Int?         @map("duration_ms")
  error       String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("sync_logs")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
